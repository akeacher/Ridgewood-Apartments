# macOS
.DS_Store

# Large source media. These stay on the Desktop but are deliberately kept out of
# the repo: the video is not referenced anywhere on the site, and the full-size
# originals are already baked into the pages as optimised copies. Git is not a
# backup — keep these in iCloud or Time Machine.
assets/property-video.mp4
photos/raw/
photos/*.JPG
photos/*.jpg
photos/*.PNG
photos/*.png
!photos/web/

# Scratch previews generated by the tools/ scripts; all regenerable
tools/preview*.html
tools/z-*.html
tools/z2-*.html

# Booking app (it has its own .gitignore too)
tour-booking-app/node_modules/
tour-booking-app/.env
tour-booking-app/*.db
tour-booking-app/*.db-shm
tour-booking-app/*.db-wal
