# ---- Server ----
PORT=3000
# Public URL of this app. Used in emails for cancel/manage links.
BASE_URL=http://localhost:3000
# Set to the property's timezone so slot times mean what you think they mean.
TZ=America/Chicago

# ---- Admin access ----
# The password you type at /admin. Use something long.
ADMIN_PASSWORD=change-me-to-a-long-random-passphrase
# Random 64+ char string. Signs the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-hex-string

# ---- Property details (shown to prospects and in emails) ----
PROPERTY_NAME=Ridgewood Apartments
PROPERTY_ADDRESS=1871 Wilson Ave, Saint Paul, MN 55119
PROPERTY_PHONE=651-578-0498
# Where "reply" goes on prospect emails, and where new-request alerts are sent.
LEASING_EMAIL=leasing@example.com

# ---- Tour availability ----
# Days of week open for tours. 0=Sun 1=Mon ... 6=Sat
TOUR_DAYS=1,2,3,4,5
# Office hours, 24h local time.
TOUR_START=13:00
TOUR_END=17:00
# Length of each tour slot in minutes.
SLOT_MINUTES=30
# Prospects cannot book a slot sooner than this many hours from now.
LEAD_TIME_HOURS=12
# How far ahead the calendar shows.
BOOKING_WINDOW_DAYS=30
# Dates to block off entirely (holidays, etc). Comma separated YYYY-MM-DD.
BLACKOUT_DATES=

# ---- Email (SMTP) ----
# Gmail: use an App Password, not your account password.
# Other good options: Resend, Postmark, Mailgun, Amazon SES.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Ridgewood Apartments <leasing@example.com>"

# Set to "true" to print emails to the console instead of sending them.
# Useful for local testing before SMTP is configured.
MAIL_DRY_RUN=true
